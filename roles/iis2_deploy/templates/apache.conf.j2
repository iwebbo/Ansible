# Apache2 Configuration Template
# Generated by iis2_deploy Ansible role

# Server global settings
ServerRoot "/etc/httpd"
User "{{ iis2_apache_user }}"
Group "{{ iis2_apache_group }}"
PidFile "{{ ansible_env.HOME }}/apache.pid"
Timeout 300
MaxClients {{ iis2_apache_port | int * 10 }}
MaxRequestsPerChild 10000

# Error logs
ErrorLog "/var/log/httpd/error_log"
LogLevel warn

# Access log
{{ "AccessLog "/var/log/httpd/access_log" if iis2_enable_access_log else '' }}

# Server signature (disable for production)
{{ "ServerSignature On" if not iis2_enable_hidden_files_protection else 'ServerSignature Off' }}

# Custom log format
CustomLog "/var/log/httpd/access_log" combined

# Virtual host configuration
<VirtualHost *:{{ iis2_apache_port | int }}>
    ServerName {{ iis2_apache_site_name }}
    DocumentRoot "{{ iis2_apache_docroot }}"

    # Enable directory indexing protection
    Options -Indexes

    # Allow specific file types
    <FilesMatch ".(gif|jpg|jpeg|png|ico)$">
        Order allow,deny
        Allow from all
    </FilesMatch>

    # Deny access to hidden files and directories
    <FilesMatch "^\.">
        Order deny,allow
        Deny from all
    </FilesMatch>

    # Enable directory listing protection
    DirectoryIndex index.html index.htm

    {{ "SSLVirtualHost" if iis2_enable_ssl else '' }}
</VirtualHost>