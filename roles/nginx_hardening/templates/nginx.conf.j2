# Nginx Configuration - Generated by nginx_hardening role
# DO NOT EDIT MANUALLY - This file is managed by Ansible

worker_processes {{ nginx_worker_processes | default('auto') }};

events {
    worker_connections {{ nginx_max_connections | default(1024) }};
    use epoll;
    multi_accept on;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Logging configuration
    access_log {{ nginx_log_dir }}/access.log {{ nginx_access_log_format }};
    error_log {{ nginx_log_dir }}/error.log {{ nginx_error_log_level }};

    # Performance settings
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;

    # Security headers (applied to all responses)
    add_header X-Frame-Options "{{ nginx_x_frame_options | default('DENY') }}" always;
    add_header X-Content-Type-Options "{{ nginx_x_content_type_options | default('nosniff') }}" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Disable server version information
    server_tokens off;

    # Rate limiting configuration
    {{ nginx_rate_limiting_block | default('') }}

    # Default server block
    server {
        listen {{ nginx_port }};
        listen [::]:{{ nginx_port }};
        server_name localhost;

        root /var/www/html;
        index index.html index.htm;

        # Security settings
        autoindex {{ nginx_autoindex | default('off') }};
        autoindex_exact_size off;
        autoindex_localtime on;

        # Hide server header
        add_header Server "" always;

        # Default location
        location / {
            try_files $uri $uri/ =404;
        }

        # Health check endpoint
        location /nginx_status {
            stub_status on;
            allow 127.0.0.1;
            deny all;
        }

        # Error pages
        error_page 500 502 503 504 /50x.html;
        location = /50x.html {
            root /usr/share/nginx/html;
        }
    }

    # SSL server block (if enabled)
    {{ nginx_ssl_server_block | default('') }}
}

# Rate limiting block
{% if nginx_enable_rate_limiting %}
map $remote_addr $limit_conn_zone {
    default zone=rate_limit:10m;
}
{% endif %}

{% if nginx_enable_rate_limiting %}
server {
    listen {{ nginx_port }};
    listen [::]:{{ nginx_port }};
    server_name localhost;

    location / {
        limit_conn_zone $limit_conn_zone server=rate_limit;
        limit_conn rate_limit {{ nginx_max_requests_per_ip | default(10000) }};
        try_files $uri $uri/ =404;
    }
}
{% endif %}